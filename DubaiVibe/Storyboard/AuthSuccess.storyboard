                                        <rect key="frame" x="117.66666666666666" y="0.0" width="109.66666666666666" height="64.666666666666671"/>
                                        <subviews>
                                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="SVG - Globe Outline Icon" translatesAutoresizingMaskIntoConstraints="NO" id="success-feat-2-icon">
                                                <rect key="frame" x="41" y="0.0" width="28" height="28"/>
                                                <color key="tintColor" red="0.90980392156862744" green="0.72549019607843135" blue="0.39215686274509803" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                <constraints>
