                            </stackView>
                            <button opaque="NO" clipsSubviews="YES" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="success-cta" customClass="GoldGradientButton" customModule="DubaiVibe" customModuleProvider="target">
                                <rect key="frame" x="24" y="706" width="345" height="54"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="54" id="success-cta-h"/>
                                </constraints>
